{
  "name": "mtg-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic MTG deck synergy analyzer with an interactive graph",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --no-warnings server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --no-warnings server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fixtures": "node --no-warnings scripts/fetch-fixtures.ts",
    "tags": "node --no-warnings scripts/inspect-tags.ts",
    "abilities": "node --no-warnings scripts/inspect-abilities.ts",
    "combos": "node --no-warnings scripts/inspect-combos.ts",
    "bench": "node --no-warnings scripts/benchmark.ts",
    "rejected": "node --no-warnings scripts/inspect-rejected.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "cytoscape": "^3.34.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
